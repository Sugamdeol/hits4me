# Copy to .env and fill in your 9Hits access key (https://panel.9hits.com/user/profile)
ACCESS_KEY=

# --- optional viewer settings (see README.md for the full list) ---
SYSTEM_SESSION=yes
ALLOW_CRYPTO=no
ALLOW_ADULT=no
ALLOW_POPUPS=no
HIDE_BROWSER=yes
NOTE=local
#EX_PROXY_SESSIONS=10
#EX_PROXY_URL=http://my-pool-url/
#BULK_ADD_PROXY_TYPE=socks5
#BULK_ADD_PROXY_LIST=server:port;user;pass|server2:port;user2;pass2
#SESSION_NOTE=pool
#RESET_INTERVAL=6h
#CACHE_LIMIT=104857600
#EXTRA_ARGS=--hide-columns=quality,points
