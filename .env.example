# Copy to .env only if you want to override a default - the 9Hits access key
# is already baked into the image (Dockerfile / docker-compose.yml), so a bare
#
#   docker compose up -d viewer
#   curl http://localhost:10000/health
#
# works with no .env at all. supervisor.py is the container's PID 1 and keeps
# the viewer alive with auto-restart on crash.
# -----------------------------------------------------------------------------
# 9Hits Viewer - access key from https://panel.9hits.com/user/profile
# Baked in by default so you can deploy without setting any env manually.
ACCESS_KEY=23f9097a8d823267188c49b3cc0598b1

# --- 9Hits viewer on/off ---
NINEHITS_ENABLED=yes

# --- Process manager / per-slot limits -------------------------------------
# The Python supervisor is the entrypoint; it owns one child per slot
# (9Hits launcher, health server) and restarts each independently on crash.
#
# Restart / backoff policy:
# SUPERVISOR_DELAY         base restart cooldown (s). Default 10.
# SUPERVISOR_MAX_DELAY     ceiling for the exponential backoff (s). Default 120.
# SUPERVISOR_PARK_AFTER    after N rapid crashes, park the slot for
#                         SUPERVISOR_PARK_SECS before the next try. Default 10.
# SUPERVISOR_PARK_SECS    park duration (s) when a slot is parked. Default 300.
# SUPERVISOR_TICK         main loop tick in seconds. Default 0.5.
#
# Health check cadence (expensive /proc scans happen at this cadence, not on
# every tick):
# NINEHITS_CHECK_INTERVAL  seconds between expensive 9Hits checks. Default 30.
#
# Memory protection (cap on the slot's process tree RSS):
# NH_MAX_MEMORY_MB / NINEHITS_MAX_MEMORY_MB
#                         when the 9Hits process tree RSS exceeds this,
#                         gracefully restart the viewer. Default 0 = off.
#                         Sensible value on a 512 MB free plan: 400.
# NH_MAX_CHILDREN / NINEHITS_MAX_CHILDREN
#                         refuse to keep a 9Hits slot whose process tree has
#                         more than N children (fork-bomb guard). Default 0 = off.
# NH_CPU_SHARES           relative CPU weight (1-262144, default = no limit).
#
# Per-slot log directory + rotation:
# LOG_DIR=/logs           logs/9hits.log, logs/health.log, logs/supervisor.log
# SLOT_LOG_MAX_BYTES      rotate per-slot log when it exceeds this size. Default 10 MiB.
# SLOT_LOG_BACKUPS        number of rotated copies to keep per slot. Default 2.

# --- 9Hits memory tuning (e.g. Render free 512 MB) --------------------------
# LOW_MEMORY=balanced is the safe default. LOW_MEMORY=extreme adds
# --single-process --in-process-gpu, which Chromium labels unsupported and
# which dies within seconds on Render's free 512 MB plan (exit code 133).
# Safety nets (details in README):
#   * NH_MAX_MEMORY_MB restarts the viewer if it runs away.
#   * INIT_TIMEOUT=600 gives the 9Hits config init pass enough time on a
#     throttled 0.1 vCPU (300s produced code 124 timeouts).
#   * Crash auto-fallback: if the viewer crash-loops at startup under
#     single-process, its SP flags are dropped automatically (NH_SP=no forces
#     that).
LOW_MEMORY=balanced             # auto | off | balanced | extreme
NH_SP=no                        # single-process for 9Hits (extreme mode only)
# CREATE_SWAP=256M              # best-effort swap where swapon is allowed
# NH_RUN_EXTRA_ARGS=--hide-columns=quality,points   # run-pass-only 9Hits flags

# --- 9Hits proxy settings (choose Option A, A+, or B) ---
# Option A: Static proxy list (5-6 sessions recommended for 512 MB free tier)
#BULK_ADD_PROXY_TYPE=socks5
#BULK_ADD_PROXY_LIST=1.2.3.4:1080;user;pass|1.2.3.5:1080;user;pass|1.2.3.6:1080;user;pass

# Option A+: Fetch proxy list on startup (e.g. Webshare download URL)
#BULK_ADD_PROXY_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/download/TOKEN/-/any/username/direct/-/

# Option B: External proxy pool (configured at https://dash.9hits.com/pool)
#EX_PROXY_SESSIONS=5
#EX_PROXY_URL=https://dash.9hits.com/pool/YOUR_POOL_KEY

# --- 9Hits viewer settings (see README.md for the full list) ---
CLEAR_ALL_SESSIONS=yes
SYSTEM_SESSION=no
SESSION_NOTE=my-proxies
HIDE_BROWSER=yes
ALLOW_POPUPS=no
ALLOW_ADULT=no
ALLOW_CRYPTO=no
CACHE_LIMIT=0
RESET_INTERVAL=2h
NOTE=local
#EXTRA_ARGS=--hide-columns=quality,points

# --- 9Hits runtime tuning (usually no need to change) ---
# The viewer is baked into the image at build time; DEFAULT_DL swaps it at start.
#DEFAULT_DL=https://dl.9hits.com/9hitsv6-linux64.tar.bz2
INIT_TIMEOUT=600             # max seconds for one config "init pass"
                             # (600 on Render free: 300 timed out with code 124)
#NH_WATCHDOG=yes             # restart a wedged viewer (no output AND no CPU)
#NH_WATCHDOG_STUCK=600       # seconds of silence before the watchdog engages
#NH_RESOLUTION=auto          # Xvfb resolution, e.g. 1920x1080x24
#NH_DISPLAY=:99              # X display for the viewer
#VNC=yes                     # mirror the 9Hits display with x11vnc (port 5901)
#VNC_PW=change-me
