# Copy to .env and fill in your access keys.
# -----------------------------------------------------------------------------
# TWO INDEPENDENT DEPLOYMENTS
#
#   viewers   (9Hits deployment)  -> runs ONLY 9Hits, plus a keep-alive
#                                    pinger for the separate FeelingSurf service.
#   feelingsurf (separate)        -> runs ONLY FeelingSurf.
#
# QUICK START - run the 9Hits deployment with one command:
#
#   cp .env.example .env
#   # edit .env: set ACCESS_KEY (9Hits)
#   docker compose up -d viewers
#   curl http://localhost:10000/health
#
#   # run the separate FeelingSurf deployment (its own container):
#   docker compose up -d feelingsurf
#   curl http://localhost:10001/health
#
# The `viewers` image defaults to 9Hits ON, FeelingSurf OFF (FeelingSurf runs
# in its own separate deployment via Dockerfile.feelingsurf). supervisor.py is
# the container's PID 1 and keeps the viewer alive with auto-restart on crash.
# -----------------------------------------------------------------------------
# 9Hits Viewer - access key from https://panel.9hits.com/user/profile
# Baked in by default so you can deploy without setting any env manually.
ACCESS_KEY=23f9097a8d823267188c49b3cc0598b1

# --- 9Hits viewer on/off ---
# This is the 9Hits deployment: 9Hits is ON by default, FeelingSurf is OFF
# (FeelingSurf runs in the separate `feelingsurf` deployment).
NINEHITS_ENABLED=yes

# --- Process manager / per-slot limits -------------------------------------
# The Python supervisor is the entrypoint; it owns one child per slot
# (9Hits launcher, FeelingSurf launcher, health server) and restarts each
# independently on crash. The supervisor is the container's PID 1 - it stays
# up for the full lifetime of the container and keeps the viewers running 24x7.
#
# Restart / backoff policy:
# SUPERVISOR_DELAY         base restart cooldown (s). Default 10.
# SUPERVISOR_MAX_DELAY     ceiling for the exponential backoff (s). Default 120.
# SUPERVISOR_PARK_AFTER    after N rapid crashes, park the slot for
#                         SUPERVISOR_PARK_SECS before the next try. Default 10.
# SUPERVISOR_PARK_SECS    park duration (s) when a slot is parked. Default 300.
# SUPERVISOR_TICK         main loop tick in seconds. Default 0.5. Lower = faster
#                         signal/crash response, slightly higher steady-state CPU.
#
# Per-viewer health check cadence (expensive /proc scans happen at this
# cadence, not on every tick):
# NINEHITS_CHECK_INTERVAL  seconds between expensive 9Hits checks. Default 30.
# FEELINGSURF_CHECK_INTERVAL   same for FeelingSurf. Default 30.
#
# Per-viewer memory protection (cap on the slot's process tree RSS):
# NH_MAX_MEMORY_MB / NINEHITS_MAX_MEMORY_MB
#                         when 9Hits process tree RSS exceeds this, gracefully
#                         restart ONLY 9Hits. Default 0 = off. Sensible value
#                         on a 512 MB free plan: 400 (9Hits v6 idles at
#                         ~250-400 MB, so 400 is the upper bound for normal
#                         operation; the supervisor acts before the viewer
#                         can crash the container).
# FS_MAX_MEMORY_MB / FEELINGSURF_MAX_MEMORY_MB
#                         same for FeelingSurf. Default 0 = off. Sensible
#                         value on a 512 MB free plan: 400.
# NH_MAX_CHILDREN / NINEHITS_MAX_CHILDREN
#                         refuse to keep a 9Hits slot whose process tree has
#                         more than N children (fork-bomb guard). Default 0 = off.
# FS_MAX_CHILDREN / FEELINGSURF_MAX_CHILDREN
#                         same for FeelingSurf. Default 0 = off.
#
# Per-viewer CPU weight (Linux cgroup v1 nice-like, applied when supported):
# NH_CPU_SHARES / FS_CPU_SHARES
#                         relative CPU weight (1-262144, default = no limit).
#
# Per-slot log directory + rotation:
# LOG_DIR=/logs           logs/9hits.log, logs/feelingsurf.log, logs/health.log,
#                         logs/supervisor.log
# SLOT_LOG_MAX_BYTES      rotate per-slot log when it exceeds this size. Default 10 MiB.
# SLOT_LOG_BACKUPS        number of rotated copies to keep per slot. Default 2.
#                         Worst-case disk: 3 slots * (10 MiB + 2 * 10 MiB) = 90 MiB.

# --- 9Hits memory tuning (single-viewer, e.g. Render free 512 MB) -----------
# LOW_MEMORY=balanced is the safe default here. LOW_MEMORY=extreme adds
# --single-process --in-process-gpu, which Chromium labels unsupported and
# which dies within seconds on Render's free 512 MB plan (exit code 133).
# Safety nets (details in README):
#   * NH_MAX_MEMORY_MB restarts only 9Hits if it runs away.
#   * INIT_TIMEOUT=600 gives the 9Hits config init pass enough time on a
#     throttled 0.1 vCPU (300s produced code 124 timeouts).
#   * Crash auto-fallback: if the viewer crash-loops at startup under
#     single-process, its SP flags are dropped automatically (NH_SP=no forces
#     that).
DUAL_VIEWER_MODE=off            # single-viewer box
TIME_SLICE=1500                 # (time-slice mode - not used here)
LOW_MEMORY=balanced             # auto | off | balanced | extreme
NH_SP=no                        # single-process for 9Hits (extreme mode only)
# CREATE_SWAP=256M              # best-effort swap where swapon is allowed
# NH_RUN_EXTRA_ARGS=--hide-columns=quality,points   # run-pass-only 9Hits flags

# --- 9Hits proxy settings (choose Option A, A+, or B) ---
# Option A: Static proxy list (5-6 sessions recommended for 512 MB free tier)
#BULK_ADD_PROXY_TYPE=socks5
#BULK_ADD_PROXY_LIST=1.2.3.4:1080;user;pass|1.2.3.5:1080;user;pass|1.2.3.6:1080;user;pass|1.2.3.7:1080;user;pass|1.2.3.8:1080;user;pass

# Option A+: Fetch proxy list on startup (e.g. Webshare download URL)
#BULK_ADD_PROXY_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/download/TOKEN/-/any/username/direct/-/

# Option B: External proxy pool (configured at https://dash.9hits.com/pool)
#EX_PROXY_SESSIONS=5
#EX_PROXY_URL=https://dash.9hits.com/pool/YOUR_POOL_KEY

# --- 9Hits viewer settings (see README.md for the full list) ---
CLEAR_ALL_SESSIONS=yes
SYSTEM_SESSION=no
SESSION_NOTE=my-proxies
HIDE_BROWSER=yes
ALLOW_POPUPS=no
ALLOW_ADULT=no
ALLOW_CRYPTO=no
CACHE_LIMIT=0
RESET_INTERVAL=2h
NOTE=local
#EXTRA_ARGS=--hide-columns=quality,points

# --- 9Hits runtime tuning (usually no need to change) ---
# The viewer is baked into the image at build time; DEFAULT_DL swaps it at start.
#DEFAULT_DL=https://dl.9hits.com/9hitsv6-linux64.tar.bz2
INIT_TIMEOUT=600             # max seconds for one config "init pass"
                             # (600 on Render free: 300 timed out with code 124)
#NH_WATCHDOG=yes             # restart a wedged viewer (no output AND no CPU)
#NH_WATCHDOG_STUCK=600       # seconds of silence before the watchdog engages
#NH_RESOLUTION=auto          # Xvfb resolution, e.g. 1920x1080x24
#NH_DISPLAY=:99              # X display for 9Hits (FeelingSurf uses :98)
#VNC=yes                     # mirror the 9Hits display with x11vnc (port 5901)
#VNC_PW=change-me


# -----------------------------------------------------------------------------
# FeelingSurf Viewer - access token from https://www.feelingsurf.fr/member
# (Profile / API token / Your access token). FeelingSurf runs in its own
# SEPARATE deployment (Dockerfile.feelingsurf / the `feelingsurf` service),
# NOT in the 9Hits deployment above.
#
# In the 9Hits deployment FEELINGSURF_ENABLED is OFF by default. Set it to
# "yes" only if you intentionally want FeelingSurf running inside the same
# container as 9Hits.
#
# Equivalent to the official quick start:
#   docker run -d \
#     -e access_token=$ACCESS_TOKEN \
#     --tmpfs /tmp \
#     --tmpfs /dev/shm \
#     feelingsurf/viewer:stable
# Baked in by default so you can deploy without setting any env manually.
ACCESS_TOKEN=27f77ef00e768cdbdc7352f3456e35b5

# OFF here - FeelingSurf runs in the separate `feelingsurf` deployment.
FEELINGSURF_ENABLED=no

# Optional FeelingSurf tuning used by the separate `feelingsurf` service:
#FS_SP=no                        # single-process for FeelingSurf (extreme only)
#FS_GL_MODE=swiftshader          # swiftshader | disable-gpu (last resort)
#FS_EXTRA_FLAGS=                 # extra FeelingSurf flags (appended last)

# -----------------------------------------------------------------------------
# Keep-alive pinger (runs inside the 9Hits deployment, for the SEPARATE
# FeelingSurf deployment)
#
# The 9Hits deployment (`viewers` / 9hits-viewer) can act as a lightweight
# keep-alive client for the separate FeelingSurf deployment (see
# Dockerfile.feelingsurf). Every FEELINGSURF_PING_INTERVAL seconds it sends a
# tiny HTTP GET to FEELINGSURF_URL so free-tier hosts keep the FeelingSurf
# service awake. The pinger runs as a background daemon thread in
# supervisor.py - it can never block, crash, or restart the 9Hits app, and a
# failed/unreachable FeelingSurf ping is just logged and retried next interval.
#
# The pinger resolves its target automatically: FEELINGSURF_URL ->
# FEELINGSURF_INTERNAL_URL -> platform auto-detection. It is only disabled
# when none of those yields a URL.
#
#   FEELINGSURF_URL             Public URL of the SEPARATE FeelingSurf
#                               deployment, e.g.
#                               https://your-feelingsurf-service.example.com
#                               On docker-compose this defaults to the
#                               internal service DNS (http://feelingsurf:10000)
#                               so the two services find each other on any
#                               host automatically - no IP/URL to set.
#   FEELINGSURF_INTERNAL_URL    In-cluster/internal DNS of the FeelingSurf
#                               deployment when it shares the 9Hits network.
#   FEELINGSURF_PING_INTERVAL   Seconds between pings. Default 300 (5 min).
#                               e.g. FEELINGSURF_PING_INTERVAL=300
#   FEELINGSURF_PING_TIMEOUT    Per-request timeout (s). Default 10.
#
# It pings <URL>/health first; if that returns 404 it falls back to <URL>/ so
# it works whether or not the FeelingSurf service exposes a /health endpoint.
#
# On docker-compose no URL is needed at all: the 9Hits deployment pings the
# `feelingsurf` service by its compose name automatically.
#
# Deployment architecture (two independent services):
#   9Hits deployment (9Hits only)  --pings every 5 min-->  FeelingSurf deployment
FEELINGSURF_URL=
# FEELINGSURF_INTERNAL_URL=http://feelingsurf:10000
FEELINGSURF_PING_INTERVAL=300
# FEELINGSURF_PING_TIMEOUT=10
